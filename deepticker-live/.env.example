# Copy to .env.local for local development, or set these as real environment
# variables in your hosting platform (Vercel / Docker / etc) for production.

# REQUIRED for production: SEC EDGAR requires a descriptive User-Agent that
# includes a real contact — https://www.sec.gov/os/webmaster-faq#developers
# Requests with a generic default may be throttled or blocked.
SEC_USER_AGENT="YourCompany DeepTicker contact@yourdomain.com"

# Optional: Upstash Redis REST credentials. When set, the in-memory cache and
# rate limiter are backed by Redis instead, so limits/caching hold correctly
# across multiple serverless instances. Without these, both fall back to
# per-instance memory (fine for a single always-on server, not for a
# horizontally-scaled serverless deployment).
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# Requests per IP allowed per window on /api/analyze/[ticker].
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Hard timeout (ms) for each outbound Yahoo Finance call.
YAHOO_TIMEOUT_MS=10000

# debug | info | warn | error
LOG_LEVEL=info
